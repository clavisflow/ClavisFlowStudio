# Browser-safe values only. Never put the service role or AI API key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Edge Function secrets (copy to supabase/.env only for local development)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
ALLOWED_ORIGIN=http://localhost:3000
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=replace-me
OPENAI_COMPATIBLE_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
RATE_LIMIT_HASH_SECRET=replace-with-at-least-32-random-characters
